# ========================================
# VARIABLES DE ENTORNO - CREDIT VALIDATION
# ========================================

# API Backend URL
# Para desarrollo local: http://127.0.0.1:8000/api
# Para producción: https://tu-dominio-backend.com/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Ambiente de ejecución
NODE_ENV=development

# Puerto para Expo (opcional)
EXPO_PORT=8081

# Protocolo de la aplicación (para deep linking)
EXPO_PUBLIC_APP_SCHEME=creditvalidation

# Debug mode
EXPO_DEBUG=false
